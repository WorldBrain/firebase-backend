{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
        },
        {
            "source": "functions-py",
            "codebase": "dead-simple-rag",
            "runtime": "python310",
            "ignore": [
                "venv",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ],
    "storage": {
        "rules": "storage.rules"
    },
    "database": {
        "rules": "database.rules.json"
    }
}
